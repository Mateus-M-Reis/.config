+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Layouts
+import Quickshell
+import Quickshell.Io
+import Caelestia.Config
+import Caelestia.I18n
+import qs.components
+import qs.components.controls
+import qs.services
+import qs.utils
+
+Item {
+    id: root
+
+    required property ShellScreen screen
+
+    readonly property var monitor: Brightness.getMonitorForScreen(screen)
+    readonly property real step: GlobalConfig.services.brightnessIncrement
+
+    property bool nightLightOn: true
+    property bool nightLightBusy: false
+
+    implicitWidth: Tokens.sizes.bar.audioWidth
+    implicitHeight: layout.implicitHeight + Tokens.padding.medium * 2
+
+    function setNightLight(on: bool): void {
+        nightLightOn = on;
+        nightLightBusy = true;
+        toggleProc.command = ["sh", "-c", `exec "${Paths.home}/.config/hypr/utils/nightlight.sh" ${on ? "on" : "off"}`];
+        toggleProc.running = true;
+    }
+
+    Component.onCompleted: statusProc.running = true
+
+    ColumnLayout {
+        id: layout
+
+        anchors.left: parent.left
+        anchors.right: parent.right
+        anchors.verticalCenter: parent.verticalCenter
+        spacing: Tokens.spacing.small
+
+        RowLayout {
+            Layout.fillWidth: true
+            spacing: Tokens.spacing.small
+
+            MaterialIcon {
+                text: "wb_sunny"
+                font: Tokens.font.icon.medium
+                color: Colours.palette.m3primary
+            }
+
+            StyledText {
+                Layout.fillWidth: true
+                text: Tr.tr("Display")
+                font: Tokens.font.body.builders.medium.weight(Font.Medium).build()
+                color: Colours.palette.m3onSurface
+            }
+
+            StyledText {
+                text: `${Math.round((root.monitor?.brightness ?? 0) * 100)}%`
+                font: Tokens.font.body.builders.medium.weight(Font.Medium).build()
+                color: Colours.palette.m3onSurfaceVariant
+            }
+        }
+
+        CustomMouseArea {
+            Layout.fillWidth: true
+            implicitHeight: Tokens.padding.medium * 3
+
+            onWheel: event => {
+                if (!root.monitor)
+                    return;
+                const delta = event.angleDelta.y > 0 ? root.step : -root.step;
+                root.monitor.setBrightness(root.monitor.brightness + delta);
+            }
+
+            StyledSlider {
+                anchors.left: parent.left
+                anchors.right: parent.right
+                implicitHeight: parent.implicitHeight
+
+                value: root.monitor?.brightness ?? 0
+                onInteraction: v => root.monitor?.setBrightness(v)
+            }
+        }
+
+        RowLayout {
+            Layout.fillWidth: true
+            Layout.topMargin: Tokens.spacing.medium
+            spacing: Tokens.spacing.small
+
+            MaterialIcon {
+                text: "bedtime"
+                font: Tokens.font.icon.medium
+                color: root.nightLightOn ? Colours.palette.m3primary : Colours.palette.m3onSurfaceVariant
+            }
+
+            StyledText {
+                Layout.fillWidth: true
+                text: Tr.tr("Night light")
+                color: Colours.palette.m3onSurface
+            }
+
+            StyledSwitch {
+                id: nightSwitch
+
+                checked: true
+                enabled: !root.nightLightBusy
+                onToggled: root.setNightLight(checked)
+            }
+        }
+    }
+
+    Process {
+        id: statusProc
+
+        command: ["sh", "-c", `exec "${Paths.home}/.config/hypr/utils/nightlight.sh" status`]
+
+        stdout: StdioCollector {
+            onStreamFinished: {
+                const on = text.trim() === "on";
+                root.nightLightOn = on;
+                nightSwitch.checked = on;
+            }
+        }
+    }
+
+    Process {
+        id: toggleProc
+
+        onExited: {
+            root.nightLightBusy = false;
+            statusProc.running = true;
+        }
+    }
+}
