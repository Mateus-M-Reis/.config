# Function key colors
color_function_key=#ffe4bf
color_function_desc=#f9e0db

# Tree view colors
color_tree_line=#84716d
color_tree_collapsed=#f9b7a8
color_tree_expanded=#e7bdb4

# Load average colors
color_load_low=#ffd8c0
color_load_med=#ffeee7
color_load_high=#ff988c

# Priority colors
