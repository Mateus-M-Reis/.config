color_cpu_high=#ff988c

# Memory meter colors
color_mem_used=#ffa2bd
color_mem_buffers=#ffdb94
color_mem_cache=#f2b2f2
color_mem_available=#ffd8c0

# Process list colors
color_process_normal=#f9e0db
color_process_running=#ffd8c0
color_process_sleeping=#84716d
color_process_zombie=#ff988c
color_process_stopped=#ffeee7

# Header and border colors
color_header=#bca6a2
color_border=#84716d
